{
  "title": "Business Metrics",
  "uid": "business-metrics",
  "description": "Custom application-level business counters and gauges: orders processed and active users, exported via prometheus_client alongside the standard HTTP metrics.",
  "schemaVersion": 39,
  "version": 1,
  "tags": ["business", "custom-metrics", "prometheus"],
  "timezone": "browser",
  "refresh": "1m",
  "time": { "from": "now-24h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "label": "Datasource",
        "query": "prometheus",
        "current": { "text": "Prometheus", "value": "Prometheus" },
        "hide": 0
      },
      {
        "name": "job",
        "type": "query",
        "label": "Job",
        "datasource": { "type": "prometheus", "uid": "${datasource}" },
        "query": "label_values(orders_processed_total, job)",
        "refresh": 2,
        "includeAll": false,
        "multi": false,
        "current": { "text": "", "value": "" },
        "options": [],
        "hide": 0
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Orders Processed Rate",
      "description": "sum(rate(orders_processed_total))",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "expr": "sum(rate(orders_processed_total{job=\"$job\"}[5m]))",
          "refId": "A",
          "legendFormat": "orders/sec"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "options": {}
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Active Users",
      "description": "Current active user gauge",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "expr": "sum(active_users{job=\"$job\"})",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "id": 3,
      "type": "gauge",
      "title": "Active Users (Gauge)",
      "description": "Same active_users metric rendered as a gauge against a rough capacity threshold",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "expr": "sum(active_users{job=\"$job\"})",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "max": 10000,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 7500 },
              { "color": "red", "value": 9500 }
            ]
          }
        },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "id": 4,
      "type": "table",
      "title": "Orders Processed by Job",
      "description": "topk(5) order processing rate grouped by job",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "expr": "topk(5, sum(rate(orders_processed_total[5m])) by (job))",
          "refId": "A",
          "format": "table"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "options": {}
    }
  ]
}
